            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "option_id",
          "text"
        ],
        "additionalProperties": false
      },
      "SubmissionRequest": {
        "type": "object",
        "properties": {
          "attempt_id": {
            "type": "string",
            "format": "uuid"
          },
          "answers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "question_id": {
                  "type": "string",
                  "pattern": "^q[0-9]{2,}$"
                },
                "option_id": {
                  "type": "string",
                  "enum": [
                    "a",
                    "b",
                    "c",
                    "d"
                  ]
                }
              },
              "required": [
                "question_id",
                "option_id"
              ],
              "additionalProperties": false
            },
            "minItems": 5,
            "maxItems": 14
          }
        },
        "required": [
          "attempt_id",
          "answers"
        ],
        "additionalProperties": false
      },
      "SelectedOptionRequest": {
        "type": "object",
        "properties": {
          "selected_option_id": {"type": "string", "enum": ["a", "b", "c", "d"]}
        },
        "required": ["selected_option_id"],
        "additionalProperties": false
      },
      "AnswerCheckResponse": {
        "type": "object",
        "properties": {
          "request_id": {"type": "string", "format": "uuid"},
          "attempt_id": {"type": "string", "format": "uuid"},
          "question_id": {"type": "string", "pattern": "^q[0-9]{2,}$"},
          "selected_option_id": {"type": "string", "enum": ["a", "b", "c", "d"]},
          "correct_option_id": {"type": "string", "enum": ["a", "b", "c", "d"]},
          "is_correct": {"type": "boolean"}
        },
        "required": ["request_id", "attempt_id", "question_id", "selected_option_id", "correct_option_id", "is_correct"],
        "additionalProperties": false
      },
      "ExplanationResponse": {
        "type": "object",
        "properties": {
          "request_id": {"type": "string", "format": "uuid"},
          "attempt_id": {"type": "string", "format": "uuid"},
          "question_id": {"type": "string", "pattern": "^q[0-9]{2,}$"},
          "selected_option_id": {"type": "string", "enum": ["a", "b", "c", "d"]},
          "correct_option_id": {"type": "string", "enum": ["a", "b", "c", "d"]},
          "explanation": {"type": "string", "minLength": 1, "maxLength": 3000},
          "source_pages": {
            "type": "array",
            "items": {"$ref": "#/components/schemas/ExplanationSourcePage"},
            "minItems": 1
          }
        },
        "required": ["request_id", "attempt_id", "question_id", "selected_option_id", "correct_option_id", "explanation", "source_pages"],
        "additionalProperties": false
      },
      "ExplanationSourcePage": {
        "type": "object",
        "properties": {
          "slide_number": {"type": "integer", "minimum": 1, "maximum": 14},
          "source_id": {"type": "string", "pattern": "^day(0[1-9]|1[0-4])(?:-d[0-9]{2,})?-p[0-9]{3,}-s[0-9]{2,}$"},
          "file_name": {"type": "string", "minLength": 1},
          "page": {"type": "integer", "minimum": 1},
          "text": {"type": "string", "minLength": 1},
          "text_is_complete": {"type": "boolean", "description": "True when text is the full extracted text of this PDF page; false for a partial legacy/demo passage."},
          "image_url": {
            "oneOf": [
              {"type": "string", "format": "uri-reference"},
              {"type": "null"}
            ],
            "description": "Same-origin private PNG route; null if the original PDF is unavailable."
          }
        },
        "required": ["slide_number", "source_id", "file_name", "page", "text", "image_url", "text_is_complete"],
        "additionalProperties": false
      },
      "SubmissionResponse": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "attempt_id": {
            "type": "string",
            "format": "uuid"
          },
          "correct_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 14
          },
          "total_questions": {
            "type": "integer",
            "enum": [
              5,
              14
            ]
          },
          "score_percent": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScoredQuestion"
            },
            "minItems": 5,
            "maxItems": 14
          }
        },
        "required": [
          "request_id",
          "attempt_id",
          "correct_count",
          "total_questions",
          "score_percent",
          "items"
        ],
        "additionalProperties": false
      },
      "ScoredQuestion": {
        "type": "object",
        "properties": {
          "question_id": {
            "type": "string",
            "pattern": "^q[0-9]{2,}$"
          },
          "selected_option_id": {
            "type": "string",
            "enum": [
              "a",
              "b",
              "c",
              "d"
            ]
          },
          "correct_option_id": {
            "type": "string",
            "enum": [
              "a",
              "b",
              "c",
              "d"
            ]
          },
          "is_correct": {
            "type": "boolean"
          },
          "citations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
