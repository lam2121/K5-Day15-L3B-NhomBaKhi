      }
    },
    "/admin/slides": {
      "get": {
        "operationId": "listAdminSlides",
        "security": [
          {
            "adminBasic": []
          }
        ],
        "responses": {
          "200": {
            "description": "All 14 slots",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminList"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid admin credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string"
                },
                "description": "HTTP Basic challenge"
              }
            }
          }
        }
      }
    },
    "/admin/slides/{slide_number}": {
      "parameters": [
        {
          "name": "slide_number",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 1,
            "maximum": 14
          }
        }
      ],
      "get": {
        "operationId": "getAdminSlide",
        "security": [
          {
            "adminBasic": []
          }
        ],
        "responses": {
          "200": {
            "description": "Slot, revisions and preview",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminDetail"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid admin credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string"
                },
                "description": "HTTP Basic challenge"
              }
            }
          },
          "422": {
            "description": "Chỉ có vị trí 01–14.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "request_id": "d74340b3-f40c-4e17-ab68-9e9a2b15e812",
                  "error": {
                    "code": "invalid_input",
                    "message": "Chỉ có vị trí 01–14."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/admin/slides/{slide_number}/draft": {
      "parameters": [
        {
          "name": "slide_number",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 1,
            "maximum": 14
          }
        }
      ],
      "put": {
        "operationId": "uploadSlideDraft",
        "security": [
          {
            "adminBasic": []
          }
        ],
        "description": "Replaces only the slot's draft after all PDFs validate. Multipart uses repeated files fields. Maximum 5 text PDFs, 10 MiB per file and 25 MiB total. Excludes encrypted or image-only documents.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "files": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "binary",
                      "contentMediaType": "application/pdf"
                    },
                    "minItems": 1,
                    "maxItems": 5
                  }
                },
                "required": [
                  "files"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "New draft and preview",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminDetail"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid admin credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string"
                },
                "description": "HTTP Basic challenge"
              }
            }
          },
          "403": {
            "description": "Yêu cầu khác nguồn không được phép.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "request_id": "d74340b3-f40c-4e17-ab68-9e9a2b15e812",
                  "error": {
                    "code": "forbidden_origin",
                    "message": "Yêu cầu khác nguồn không được phép."
                  }
                }
              }
            }
          },
          "413": {
            "description": "Request exceeds upload limit."
          },
          "415": {
            "description": "Chỉ hỗ trợ PDF.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "request_id": "d74340b3-f40c-4e17-ab68-9e9a2b15e812",
                  "error": {
                    "code": "unsupported_file",
                    "message": "Chỉ hỗ trợ PDF."
                  }
                }
              }
            }
          },
          "422": {
            "description": "PDF bị lỗi, bị khóa hoặc thiếu lớp văn bản.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "request_id": "d74340b3-f40c-4e17-ab68-9e9a2b15e812",
                  "error": {
                    "code": "invalid_document",
                    "message": "PDF bị lỗi, bị khóa hoặc thiếu lớp văn bản."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/admin/slides/{slide_number}/publish": {
      "parameters": [
        {
          "name": "slide_number",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 1,
            "maximum": 14
          }
        }
      ],
      "post": {
        "operationId": "publishSlideDraft",
        "security": [
          {
            "adminBasic": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PublishRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Published revision visible in catalog",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminDetail"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid admin credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string"
                },
                "description": "HTTP Basic challenge"
              }
            }
          },
          "403": {
            "description": "Yêu cầu khác nguồn không được phép.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "request_id": "d74340b3-f40c-4e17-ab68-9e9a2b15e812",
                  "error": {
                    "code": "forbidden_origin",
                    "message": "Yêu cầu khác nguồn không được phép."
                  }
                }
              }
            }
          },
          "409": {
            "description": "Bản nháp đã thay đổi. Hãy tải lại để duyệt.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "request_id": "d74340b3-f40c-4e17-ab68-9e9a2b15e812",
                  "error": {
                    "code": "stale_draft",
                    "message": "Bản nháp đã thay đổi. Hãy tải lại để duyệt."
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "adminBasic": {
        "type": "http",
        "scheme": "basic",
        "description": "HTTPS required when deployed. Admin credentials come from service configuration."
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "mode": {
            "type": "string",
            "enum": [
              "fake",
              "live"
            ]
          },
          "version": {
            "type": "string",
            "pattern": "^(local|[a-f0-9]{40})$"
          }
        },
        "required": [
          "status",
          "mode",
          "version"
        ],
        "additionalProperties": false
      },
      "CatalogResponse": {
        "type": "object",
        "properties": {
          "exams": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CatalogExam"
            },
            "minItems": 15,
            "maxItems": 15
          }
        },
        "required": [
          "exams"
        ],
        "additionalProperties": false
      },
      "CatalogExam": {
        "type": "object",
        "properties": {
          "exam_id": {
            "type": "string",
            "pattern": "^(slide-(0[1-9]|1[0-4])|midterm)$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "slide_number": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 14
              },
              {
                "type": "null"
              }
            ]
          },
          "available": {
            "type": "boolean"
          },
          "reason": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "question_count": {
            "type": "integer",
            "enum": [
              5,
              14
            ]
          }
        },
        "required": [
          "exam_id",
          "title",
          "slide_number",
          "available",
          "reason",
          "question_count"
        ],
        "additionalProperties": false
      },
      "AttemptRequest": {
        "type": "object",
        "properties": {
          "exam_id": {
            "type": "string",
            "pattern": "^(slide-(0[1-9]|1[0-4])|midterm)$"
          }
        },
        "required": [
          "exam_id"
        ],
        "additionalProperties": false
      },
      "AttemptResponse": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "mode": {
            "type": "string",
            "enum": [
              "fake",
              "live"
            ]
          },
          "attempt_id": {
            "type": "string",
            "format": "uuid"
          },
          "exam_id": {
            "type": "string",
            "pattern": "^(slide-(0[1-9]|1[0-4])|midterm)$"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "questions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicQuestion"
            },
            "minItems": 5,
            "maxItems": 14
          }
        },
        "required": [
          "request_id",
          "mode",
          "attempt_id",
          "exam_id",
          "expires_at",
          "questions"
        ],
        "additionalProperties": false,
        "if": {
          "properties": {
            "exam_id": {
              "const": "midterm"
            }
          }
        },
        "then": {
          "properties": {
            "questions": {
              "minItems": 14,
              "maxItems": 14
            }
          }
        },
        "else": {
          "properties": {
            "questions": {
              "minItems": 5,
              "maxItems": 5
            }
          }
        }
      },
      "PublicQuestion": {
        "type": "object",
        "properties": {
          "question_id": {
            "type": "string",
            "pattern": "^q[0-9]{2,}$"
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Option"
            },
            "minItems": 4,
            "maxItems": 4
          }
        },
        "required": [
          "question_id",
          "prompt",
          "options"
        ],
        "additionalProperties": false
      },
      "Option": {
        "type": "object",
        "properties": {
