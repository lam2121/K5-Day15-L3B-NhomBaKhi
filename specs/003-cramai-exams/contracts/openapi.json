        },
        "required": [
          "question_id",
          "selected_option_id",
          "correct_option_id",
          "is_correct",
          "citations"
        ],
        "additionalProperties": false
      },
      "Citation": {
        "type": "object",
        "properties": {
          "slide_number": {
            "type": "integer",
            "minimum": 1,
