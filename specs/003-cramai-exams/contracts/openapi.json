{
  "openapi": "3.1.1",
  "info": {
    "title": "CramAI Exam API",
    "version": "1.0.0",
    "description": "Same-origin exam catalog, admin document publishing, grounded exam attempts and scoring."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "description": "Checks service health without invoking a model.",
        "responses": {
          "200": {
            "description": "Service ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/catalog": {
      "get": {
        "operationId": "listExams",
        "description": "Exactly slide-01 through slide-14 in order, followed by midterm. Availability is evaluated against published revisions.",
        "responses": {
          "200": {
            "description": "Exam catalog",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogResponse"
                }
              }
            }
          }
        }
      }
    },
    "/attempts": {
      "post": {
        "operationId": "createAttempt",
        "description": "Consumes one generation attempt and stores a snapshot for 60 minutes. Response omits answer keys and citations. Never auto-retry.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AttemptRequest"
              },
              "example": {
                "exam_id": "slide-03"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Generated quiz",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AttemptResponse"
                },
                "example": {
                  "request_id": "92a41797-0f79-45c1-9361-c6b11c4d3e3e",
                  "mode": "fake",
                  "attempt_id": "69b82048-2aac-4cd0-ad70-2d85f507e6c1",
                  "exam_id": "slide-03",
                  "expires_at": "2026-11-27T11:30:00Z",
                  "questions": [
                    {
                      "question_id": "q01",
                      "prompt": "Mốc nào được dùng để cố định cách chấm?",
                      "options": [
                        {
                          "option_id": "a",
                          "text": "CP1"
                        },
                        {
                          "option_id": "b",
                          "text": "CP2"
                        },
                        {
                          "option_id": "c",
                          "text": "CP3"
                        },
                        {
                          "option_id": "d",
                          "text": "CP4"
                        }
                      ]
                    },
                    {
                      "question_id": "q02",
                      "prompt": "Khi thiếu căn cứ, nên làm gì?",
                      "options": [
                        {
                          "option_id": "a",
                          "text": "Suy đoán"
                        },
                        {
                          "option_id": "b",
                          "text": "Thu hẹp phạm vi"
                        },
                        {
                          "option_id": "c",
                          "text": "Tạo thêm nguồn"
                        },
                        {
                          "option_id": "d",
                          "text": "Bỏ kiểm tra"
                        }
                      ]
                    },
                    {
                      "question_id": "q03",
                      "prompt": "So sánh hai lượt cần giữ yếu tố nào?",
                      "options": [
                        {
                          "option_id": "a",
                          "text": "Bộ câu thử"
                        },
                        {
                          "option_id": "b",
                          "text": "Mã phiên"
                        },
                        {
                          "option_id": "c",
                          "text": "Ngày chạy"
                        },
                        {
                          "option_id": "d",
                          "text": "Tệp môi trường"
                        }
                      ]
                    },
                    {
                      "question_id": "q04",
                      "prompt": "Nguồn hiển thị cho học viên gồm gì?",
                      "options": [
                        {
                          "option_id": "a",
                          "text": "Trang và file"
                        },
                        {
                          "option_id": "b",
                          "text": "Điểm trước nộp"
                        },
                        {
                          "option_id": "c",
                          "text": "Khóa API"
                        },
                        {
                          "option_id": "d",
                          "text": "Toàn bộ nhật ký"
                        }
                      ]
                    },
                    {
                      "question_id": "q05",
                      "prompt": "Ai duyệt nguồn trước khi mở đề?",
                      "options": [
                        {
                          "option_id": "a",
                          "text": "Học viên"
                        },
                        {
                          "option_id": "b",
                          "text": "Admin"
                        },
                        {
                          "option_id": "c",
                          "text": "Runner"
                        },
                        {
                          "option_id": "d",
                          "text": "Nhà cung cấp model"
                        }
                      ]
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Mã đề không hợp lệ.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "request_id": "d74340b3-f40c-4e17-ab68-9e9a2b15e812",
                  "error": {
                    "code": "invalid_input",
                    "message": "Mã đề không hợp lệ."
                  }
                }
              }
            }
          },
          "409": {
            "description": "Đề chưa mở vì thiếu bộ slide đã xuất bản.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "request_id": "d74340b3-f40c-4e17-ab68-9e9a2b15e812",
                  "error": {
                    "code": "exam_unavailable",
                    "message": "Đề chưa mở vì thiếu bộ slide đã xuất bản."
                  }
                }
              }
            }
          },
          "422": {
            "description": "Chưa đủ căn cứ để tạo đề theo phạm vi này.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "request_id": "d74340b3-f40c-4e17-ab68-9e9a2b15e812",
                  "error": {
                    "code": "insufficient_evidence",
                    "message": "Chưa đủ căn cứ để tạo đề theo phạm vi này."
                  }
                }
              }
            }
          },
          "429": {
            "description": "Reverse proxy or app request limit. A proxy response can be non-JSON."
          },
          "502": {
            "description": "Chưa gọi được model. Hãy thử lại sau.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "request_id": "d74340b3-f40c-4e17-ab68-9e9a2b15e812",
                  "error": {
                    "code": "upstream_error",
                    "message": "Chưa gọi được model. Hãy thử lại sau."
                  }
                }
              }
            }
          },
          "503": {
            "description": "Đang tạo đề khác. Hãy thử lại sau.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "request_id": "d74340b3-f40c-4e17-ab68-9e9a2b15e812",
                  "error": {
                    "code": "busy",
                    "message": "Đang tạo đề khác. Hãy thử lại sau."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/attempts/{attempt_id}/questions/{question_id}/check": {
      "post": {
        "operationId": "checkQuestionAnswer",
        "description": "After the learner selects an option, immediately returns correctness and the correct option from the private attempt snapshot. This does not generate an explanation or return citations/source pages.",
        "parameters": [
          {
            "name": "attempt_id",
            "in": "path",
            "required": true,
            "schema": {"type": "string", "format": "uuid"}
          },
          {
            "name": "question_id",
            "in": "path",
            "required": true,
            "schema": {"type": "string", "pattern": "^q[0-9]{2,}$"}
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/SelectedOptionRequest"},
              "example": {"selected_option_id": "b"}
            }
          }
        },
        "responses": {
          "200": {
            "description": "Correctness feedback only",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AnswerCheckResponse"}}}
          },
          "404": {
            "description": "Attempt expired or question is unavailable",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}
          },
          "422": {
            "description": "Invalid selected option",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}
          }
        }
      }
    },
    "/attempts/{attempt_id}/questions/{question_id}/explanation": {
      "post": {
        "operationId": "explainQuestion",
        "description": "Only after the learner explicitly asks, generate a grounded explanation and reveal the answer key. Original PDFs remain private in the mounted data volume; source pages are returned as one-page PNGs through an attempt- and citation-checked endpoint.",
        "parameters": [
          {
            "name": "attempt_id",
            "in": "path",
            "required": true,
            "schema": {"type": "string", "format": "uuid"}
          },
          {
            "name": "question_id",
            "in": "path",
            "required": true,
            "schema": {"type": "string", "pattern": "^q[0-9]{2,}$"}
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/SelectedOptionRequest"},
              "example": {"selected_option_id": "b"}
            }
          }
        },
        "responses": {
          "200": {
            "description": "Answer and grounded explanation requested by the learner",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ExplanationResponse"}
              }
            }
          },
          "404": {
            "description": "Attempt expired or question is unavailable",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}
          },
          "422": {
            "description": "No cited source text or invalid selected option",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}
          },
          "429": {
            "description": "Model provider is busy",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}
          },
          "502": {
            "description": "Model provider failed to generate the explanation",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}
          }
        }
      }
    },
    "/attempts/{attempt_id}/questions/{question_id}/source-pages/{source_id}": {
      "get": {
        "operationId": "getAttemptSourcePage",
        "description": "Returns only the cited page as a private PNG after validating the attempt, question, citation and expiry. The original PDF is never served to the browser.",
        "parameters": [
          {
            "name": "attempt_id",
            "in": "path",
            "required": true,
            "schema": {"type": "string", "format": "uuid"}
          },
          {
            "name": "question_id",
            "in": "path",
            "required": true,
            "schema": {"type": "string", "pattern": "^q[0-9]{2,}$"}
          },
          {
            "name": "source_id",
            "in": "path",
            "required": true,
            "schema": {"type": "string", "pattern": "^day(0[1-9]|1[0-4])(?:-d[0-9]{2,})?-p[0-9]{3,}-s[0-9]{2,}$"}
          }
        ],
        "responses": {
          "200": {
            "description": "Cited source page rasterized from the private PDF",
            "content": {"image/png": {"schema": {"type": "string", "format": "binary"}}},
            "headers": {
              "Cache-Control": {"schema": {"type": "string"}, "description": "private, no-store"},
              "X-Content-Type-Options": {"schema": {"type": "string"}, "description": "nosniff"}
            }
          },
          "404": {
            "description": "Page is not part of this attempt or the private source is unavailable",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}
          }
        }
      }
    },
    "/submissions": {
      "post": {
        "operationId": "submitAttempt",
        "description": "First valid submission is finalized. Repeating the same choice set returns the stored score. A different choice set after submission is rejected.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmissionRequest"
              },
              "example": {
                "attempt_id": "69b82048-2aac-4cd0-ad70-2d85f507e6c1",
                "answers": [
                  {
                    "question_id": "q01",
                    "option_id": "a"
                  },
                  {
                    "question_id": "q02",
                    "option_id": "a"
                  },
                  {
                    "question_id": "q03",
                    "option_id": "a"
                  },
                  {
                    "question_id": "q04",
                    "option_id": "a"
                  },
                  {
                    "question_id": "q05",
                    "option_id": "a"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Score and per-question review",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmissionResponse"
                },
                "example": {
                  "request_id": "35f435d8-e4a1-421a-9e14-3c07f28f7511",
                  "attempt_id": "69b82048-2aac-4cd0-ad70-2d85f507e6c1",
                  "correct_count": 2,
                  "total_questions": 5,
                  "score_percent": 40,
                  "items": [
                    {
                      "question_id": "q01",
                      "selected_option_id": "a",
                      "correct_option_id": "b",
                      "is_correct": false,
                      "citations": [
                        {
                          "slide_number": 3,
                          "source_id": "day03-d01-p001-s01",
                          "file_name": "demo-slide-03.pdf",
                          "page": 1
                        }
                      ]
                    },
                    {
                      "question_id": "q02",
                      "selected_option_id": "a",
                      "correct_option_id": "b",
                      "is_correct": false,
                      "citations": [
                        {
                          "slide_number": 3,
                          "source_id": "day03-d01-p001-s01",
                          "file_name": "demo-slide-03.pdf",
                          "page": 1
                        }
                      ]
                    },
                    {
                      "question_id": "q03",
                      "selected_option_id": "a",
                      "correct_option_id": "a",
                      "is_correct": true,
                      "citations": [
                        {
                          "slide_number": 3,
                          "source_id": "day03-d01-p001-s01",
                          "file_name": "demo-slide-03.pdf",
                          "page": 1
                        }
                      ]
                    },
                    {
                      "question_id": "q04",
                      "selected_option_id": "a",
                      "correct_option_id": "a",
                      "is_correct": true,
                      "citations": [
                        {
                          "slide_number": 3,
                          "source_id": "day03-d01-p001-s01",
                          "file_name": "demo-slide-03.pdf",
                          "page": 1
                        }
                      ]
                    },
                    {
                      "question_id": "q05",
                      "selected_option_id": "a",
                      "correct_option_id": "b",
                      "is_correct": false,
                      "citations": [
                        {
                          "slide_number": 3,
                          "source_id": "day03-d01-p001-s01",
                          "file_name": "demo-slide-03.pdf",
                          "page": 1
                        }
                      ]
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Bài làm không còn khả dụng. Hãy tạo lượt mới.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "request_id": "d74340b3-f40c-4e17-ab68-9e9a2b15e812",
                  "error": {
                    "code": "quiz_unavailable",
                    "message": "Bài làm không còn khả dụng. Hãy tạo lượt mới."
                  }
                }
              }
            }
          },
          "409": {
            "description": "Bài này đã nộp với lựa chọn khác.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "request_id": "d74340b3-f40c-4e17-ab68-9e9a2b15e812",
                  "error": {
                    "code": "already_submitted",
                    "message": "Bài này đã nộp với lựa chọn khác."
                  }
