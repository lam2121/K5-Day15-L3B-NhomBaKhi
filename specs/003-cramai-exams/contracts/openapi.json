          },
          "422": {
            "description": "Hãy chọn đúng một đáp án cho mỗi câu.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "request_id": "d74340b3-f40c-4e17-ab68-9e9a2b15e812",
                  "error": {
                    "code": "invalid_answers",
