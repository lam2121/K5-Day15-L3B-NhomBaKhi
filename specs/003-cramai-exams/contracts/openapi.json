          },
          "documents": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "file_name": {
                  "type": "string",
                  "minLength": 1
                },
                "page_count": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "file_name",
                "page_count"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 5
          },
          "passage_count": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "revision_id",
