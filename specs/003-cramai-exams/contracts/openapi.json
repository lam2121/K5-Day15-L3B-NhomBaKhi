            "type": "string",
            "pattern": "^day(0[1-9]|1[0-4])(?:-d[0-9]{2,})?-p[0-9]{3,}-s[0-9]{2,}$"
          },
          "file_name": {
            "type": "string",
            "minLength": 1
          },
          "page": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "slide_number",
          "source_id",
          "file_name",
          "page"
        ],
        "additionalProperties": false
      },
      "AdminList": {
        "type": "object",
        "properties": {
          "slides": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminSlot"
            },
            "minItems": 14,
            "maxItems": 14
          }
        },
        "required": [
          "slides"
        ],
        "additionalProperties": false
      },
      "AdminDetail": {
        "type": "object",
        "properties": {
          "slot": {
            "$ref": "#/components/schemas/AdminSlot"
          },
          "draft_preview": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "citation": {
                  "$ref": "#/components/schemas/Citation"
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "citation",
                "text"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 3
          }
        },
        "required": [
          "slot",
          "draft_preview"
        ],
        "additionalProperties": false
      },
      "AdminSlot": {
        "type": "object",
        "properties": {
          "slide_number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 14
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "draft": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/RevisionSummary"
              },
              {
                "type": "null"
              }
            ]
          },
          "published": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/RevisionSummary"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "slide_number",
          "title",
          "draft",
          "published"
        ],
        "additionalProperties": false
      },
      "RevisionSummary": {
        "type": "object",
        "properties": {
