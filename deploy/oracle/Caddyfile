{
    default_sni {$DOMAIN}
}

{$DOMAIN} {
    tls {
        issuer acme {
            profile shortlived
        }
    }
    encode zstd gzip
    route {
        @admin_trailing_slash path /admin/
        redir @admin_trailing_slash /admin 308

        @admin_root path /admin
        rewrite @admin_root /admin/

        reverse_proxy app:8000
    }
}
