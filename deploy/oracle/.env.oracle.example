# Copy to .env.oracle on the VPS. Keep that file private (chmod 600).
# DOMAIN can be the Oracle VPS public IPv4 address or an FQDN pointed to it.
DOMAIN=cramai.example.com

# Replace both values before exposing the site. Use a long random password.
CRAMAI_ADMIN_USER=admin
CRAMAI_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# Use fake only for a demo without a real model. For real AI set provider, model and key.
MODEL_PROVIDER=fake
MODEL_NAME=
API_KEY=
